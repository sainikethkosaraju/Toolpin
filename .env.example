# Toolpin configuration. Copy to .env (git-ignored).
# HMAC secret for call-bound approvals. REQUIRED when approvals are enabled, >= 32 chars, no default:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TOOLPIN_APPROVAL_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Secret salting the information-flow taint fingerprints (>= 16 chars). Keep it separate from the approval secret.
TOOLPIN_IFC_SECRET=replace-with-a-different-long-random-secret
TOOLPIN_LOCKFILE=./toolpin.lock
TOOLPIN_AUDIT_LOG=./toolpin-audit.jsonl
# Optional OPA endpoint for the OPA policy adapter
OPA_URL=
# Provider keys are only for optional real-model benchmark runs
NVIDIA_API_KEY=your-nvidia-key-here
GROQ_API_KEY=your-groq-key-here
