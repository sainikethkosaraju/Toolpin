# Toolpin configuration. Copy to .env (git-ignored).
# HMAC secret for call-bound approvals. REQUIRED, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TOOLPIN_APPROVAL_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Optional Ed25519 private key (PEM path) to sign audit entries
TOOLPIN_AUDIT_SIGNING_KEY=
TOOLPIN_LOCKFILE=./toolpin.lock
TOOLPIN_AUDIT_LOG=./toolpin-audit.jsonl
# Optional OPA endpoint for the OPA policy adapter
OPA_URL=
# Provider keys are only for the optional benchmark harness
NVIDIA_API_KEY=your-nvidia-key-here
GROQ_API_KEY=your-groq-key-here
